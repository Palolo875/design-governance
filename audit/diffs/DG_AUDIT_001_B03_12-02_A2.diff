+def apply_edit(document: Any, path: tuple[Any, ...], value: Any) -> None:
+    node = document
+    for key in path[:-1]:
+        node = node[key]
+    if value is DELETE:
+        del node[path[-1]]
+    else:
+        node[path[-1]] = json.loads(json.dumps(value))
+
